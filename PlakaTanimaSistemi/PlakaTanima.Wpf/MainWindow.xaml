<Window x:Class="PlakaTanima.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PlakaTanima.Wpf"
        xmlns:vm="clr-namespace:PlakaTanima.Wpf.ViewModels"
        Title="Plaka Tanıma Sistemi" Width="1200" Height="840" MinWidth="960" MinHeight="740"
        Background="{StaticResource BgBrush}" AllowDrop="True" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Boşken gizle -->
        <Style x:Key="ShowWhenEmpty" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasImage}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Durum rozeti -->
        <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Text" Value="Bekleniyor" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Text" Value="İşleniyor" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Found">
                    <Setter Property="Text" Value="Plaka bulundu" />
                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NotFound">
                    <Setter Property="Text" Value="Plaka bulunamadı" />
                    <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Text" Value="Hata" />
                    <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Durum rozeti zemini: duruma göre paletin hafif tonu -->
        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Found">
                    <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NotFound">
                    <Setter Property="Background" Value="{StaticResource WarnTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Background" Value="{StaticResource ErrorTintBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Koyu temaya uygun ince yatay kaydırma çubuğu -->
        <Style x:Key="InvisibleRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,2,0,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" Height="6" CornerRadius="3" Background="#CBD5E1" VerticalAlignment="Center" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- İşlem hattı kartlarının kabuğu: seçim çerçevesini kartın kendisi çizer. -->
        <Style x:Key="StepItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:StepCardViewModel}">
            <Border x:Name="Card" Width="176" Padding="8" CornerRadius="12" BorderThickness="1.5"
                    Background="{StaticResource SurfaceHiBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                    ToolTip="{Binding Description}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="Slide" Y="14" />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                                <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <Border CornerRadius="8" Background="#E4EBF4" Height="90" ClipToBounds="True">
                        <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="20" Height="20" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Index}" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#C3CEDF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst çubuk -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource BrandGradient}" VerticalAlignment="Center">
                    <Border Margin="6" CornerRadius="5" BorderBrush="White" BorderThickness="2">
                        <TextBlock Text="34" FontWeight="ExtraBold" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Plaka Tanıma Sistemi" FontSize="22" FontWeight="Bold" />
                    <TextBlock Style="{StaticResource MutedText}" Text="Araç fotoğrafından plaka bölgesini adım adım bulur" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="Örnek 1"
                        Command="{Binding SampleCommand}" CommandParameter="{x:Static local:MainWindow.Sample1}" />
                <Button Style="{StaticResource GhostButton}" Content="Örnek 2"
                        Command="{Binding SampleCommand}" CommandParameter="{x:Static local:MainWindow.Sample2}" />
                <Button Style="{StaticResource GhostButton}" Content="Görsel Seç…" Margin="0,0,14,0" Command="{Binding OpenCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Plakayı Tespit Et" Command="{Binding DetectCommand}" />
            </StackPanel>
        </Grid>

        <!-- Orta bölüm -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Görüntü alanı -->
            <Border Style="{StaticResource Card}" ClipToBounds="True">
                <Grid x:Name="ImageHost">
                    <Image Source="{Binding DisplayImage}" Stretch="Uniform" Margin="14,14,14,38" RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Tarama çizgisi: işlem sırasında görüntü üzerinde gezinir -->
                    <Rectangle x:Name="ScanLine" Height="3" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0000B4D8" Offset="0" />
                                <GradientStop Color="#FF00B4D8" Offset="0.5" />
                                <GradientStop Color="#0000B4D8" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <DropShadowEffect Color="#7B61FF" BlurRadius="18" ShadowDepth="0" Opacity="0.7" />
                        </Rectangle.Effect>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScanTransform" />
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- Boş durum / bırakma alanı -->
                    <Border Style="{StaticResource ShowWhenEmpty}" Margin="22" CornerRadius="12"
                            BorderBrush="#9BDDEB" BorderThickness="2" Background="#F6FCFE">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Bir araç fotoğrafını buraya sürükleyin" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,14,0,4" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                       Text="ya da yukarıdan “Görsel Seç…” veya bir örnek kullanın" />
                        </StackPanel>
                    </Border>

                    <!-- Görünüm etiketi -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="18,16,0,0">
                        <Border CornerRadius="8" Background="#E6FFFFFF" Padding="10,5" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewLabel}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ViewLabel}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Content="Sonuca dön" Margin="8,0,0,0" Padding="10,4"
                                FontSize="12" Command="{Binding ShowResultCommand}">
                            <Button.Visibility>
                                <Binding Path="SelectedStep">
                                    <Binding.Converter>
                                        <local:NullToCollapsedConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding FileName}" Style="{StaticResource MutedText}" VerticalAlignment="Bottom"
                               HorizontalAlignment="Right" Margin="0,0,18,14" />
                </Grid>
            </Border>

            <!-- Sonuç kartı -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Tespit sonucu" FontSize="16" FontWeight="Bold" />
                        <Border HorizontalAlignment="Right" Style="{StaticResource BadgeBorder}">
                            <TextBlock Style="{StaticResource BadgeText}" />
                        </Border>
                    </Grid>

                    <!-- Plaka çerçevesi -->
                    <Border Margin="0,16,0,0" Height="82" CornerRadius="10" Background="#F8FAFC" BorderBrush="#0F172A" BorderThickness="3" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#1D4ED8">
                                <TextBlock Text="TR" Foreground="White" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Image Grid.Column="1" Source="{Binding PlateImage}" Stretch="Uniform" Margin="8"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Grid.Column="1" Text="— — —" FontSize="26" FontWeight="Bold" Foreground="#CBD5E1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlateImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Okunan plaka metni -->
                    <!-- Biçim doğrulandıysa başarı tonu, doğrulanmadıysa uyarı tonu -->
                    <Border HorizontalAlignment="Center" Margin="0,12,0,0" CornerRadius="10" Padding="16,4" BorderThickness="1.5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Yerel değer olarak yazılsaydı tetikleyiciler bunları ezemezdi -->
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecognizedText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PlateTextValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                        <Setter Property="Background" Value="{StaticResource WarnTintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RecognizedText}" FontSize="28" FontWeight="ExtraBold" FontFamily="Consolas">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlateTextValid}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="20" />

                    <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,12,0,14" />

                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Konum" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding Location}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Boyut" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding Size}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource StatLabel}" Text="En / boy oranı" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding Ratio}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Süre" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding Duration}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Bulunan bölge" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding Regions}" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11"
                               Text="{Binding OcrNote}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- İşlem hattı -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14,18,16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="İşlem hattı" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Height="4" Margin="18,0,18,0" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource BrandGradient}"
                                 Background="{StaticResource BorderBrushSoft}" BorderThickness="0" />
                    <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" Text="{Binding ProgressText}" VerticalAlignment="Center" />
                </Grid>

                <Grid Height="172">
                    <ListBox x:Name="StepList" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource StepItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="“Plakayı Tespit Et” dediğinizde her adımın görüntüsü burada belirir; bir karta tıklayıp büyük görebilirsiniz.">
                        <TextBlock.Visibility>
                            <Binding Path="Steps.Count">
                                <Binding.Converter>
                                    <local:ZeroToVisibleConverter />
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
